{
  "name": "modu-house",
  "version": "0.2.0",
  "private": true,
  "description": "모두의 내집마련 — 내집마련 프로젝트 플래너",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:engine": "node --experimental-strip-types scripts/verify-engine.ts",
    "build:multi": "SINGLE=0 vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "vite-plugin-singlefile": "^2.0.0"
  }
}